# Copy this file to backend/.env (never commit .env)
# The OpenAI key is only read by FastAPI on the server; do not put it in Vite/React.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# Pick a vision-capable model that supports structured outputs.
PAYPLAN_AI_MODEL=gpt-4.1-mini
# For HTTPS deployment, set to true. This app is intended for local use until hardened.
PAYPLAN_SECURE_COOKIE=false
